# ------------------------------------------------------------
# 换行符规范
# Windows 的 core.autocrlf=true 会给文件加上 CRLF，而 Shell 脚本
# 一旦带 CRLF 在 macOS/Linux 上就会报 "bad interpreter: ^M"。
# 这里强制规定各类文件在仓库中的换行符。
# ------------------------------------------------------------

* text=auto

# Shell 脚本必须是 LF（macOS / UOS 打包脚本依赖此项）
*.sh      text eol=lf
*.command text eol=lf

# 源码与配置统一 LF
*.py      text eol=lf
*.spec    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf

# Windows 批处理必须是 CRLF
*.bat     text eol=crlf

# 二进制文件不做任何换行转换
*.png  binary
*.ico  binary
*.icns binary
*.exe  binary
*.zip  binary
*.docx binary
*.pdf  binary
